# Conexão com o PostgreSQL. Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Troque só a SENHA. O início "postgresql://" é o protocolo e não pode mudar.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shelfshare?schema=public"

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório
JWT_SECRET="altere-este-valor"

# Porta em que a API sobe
PORT=3001

# Origem liberada no CORS (onde o frontend roda)
FRONTEND_URL=http://localhost:5173

# SMTP — deixe vazio em dev para que os links apareçam no console do backend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ShelfShare <no-reply@shelfshare.app>"